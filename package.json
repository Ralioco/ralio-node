{
  "name": "@ralioco/sdk",
  "version": "0.1.2",
  "description": "Official TypeScript SDK for the Ralio agentic payment API.",
  "license": "MIT",
  "author": "Ralio",
  "homepage": "https://ralio.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ralioco/ralio-node.git"
  },
  "bugs": {
    "url": "https://github.com/Ralioco/ralio-node/issues"
  },
  "keywords": [
    "ralio",
    "payments",
    "agents",
    "sdk",
    "oauth",
    "dpop"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^10.4.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  }
}
